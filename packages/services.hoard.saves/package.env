APP_ID=services.hoard.saves
APP_NAME="Hoard"
VERSION=1.3.0
BRANCH=stable
ARCH=x86_64

RUNTIME=org.gnome.Platform
RUNTIME_VERSION=50
SDK=org.gnome.Sdk
RUNTIME_REPO=https://dl.flathub.org/repo/flathub.flatpakrepo
COMMAND=hoard-desktop

# Consumed by prepare.sh. The .deb is the desktop bundle: it carries
# hoard-desktop plus the hoardd service and the hoard CLI as sidecars, which
# have to sit in the same /app/bin directory.
DEB=Hoard_1.3.0_amd64.deb
DEB_URL=https://github.com/rleeon/hoard/releases/download/v1.3.0/Hoard_1.3.0_amd64.deb
DEB_SHA256=3281634d02bf313059e84d62bb3e490b7cb43877bfec0721a23748dc5242fedc
